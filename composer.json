{
    "name": "lvjunior-ueap/google-drive-uploader",
    "description": "Biblioteca PHP genérica para upload, listagem e gerenciamento de arquivos no Google Drive.",
    "type": "library",
    "license": "MIT",
    "authors": [
      {
        "name": "Luiz V. Junior",
        "email": "seu-email@exemplo.com"
      }
